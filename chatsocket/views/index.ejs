<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>CHATBOT</title>
</head>
<body>
    <div id="chat">
        <h1 class="title">Bienvenido al Chatbot</h1>
        <h1>USAR OLLAMA DEEPESEK PARA MODELOS PRE CARGADOS PARA EL CHATBOT</h1>
        <input type="text" id="username" placeholder="Ingrese su nombre de usuario">
        <div id="messages">
            <br>
            <div class="message">Hola </div>
            <br>
            <div class="message">hola </div>
        </div>
        <div id="writing"></div>
        <textarea id="write-message" placeholder="Escribe tu mensaje"></textarea>
    </div>


    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
        const username = document.getElementById('username');
        const writeMessage = document.getElementById('write-message');
        const messages = document.getElementById('messages');
        const writing = document.getElementById('writing');

        socket.on('all message', (m) => {
            let content = '';
            for(const message of m){
                content += `<div class="message"><b>${message.username}</b>: ${message.message}</div><br>`;
            }
            messages.innerHTML = content;
            messages.scrollTop = messages.scrollHeight;
        });

        writeMessage.addEventListener('keydown',(event)=>{
            socket.emit('writing', username.value);
        })

        socket.on('writing', (username) => {
            writing.innerHTML = `${username} está escribiendo...`;
            setTimeout(() => {
                writing.innerHTML = '';
            }, 3000);
        });

        writeMessage.addEventListener('keyup',(event)=>{
            if(event.key === 'Enter'){
                if(username.value ==""||writeMessage.value == ""){
                    alert('Por favor ingrese un nombre de usuario y un mensaje');
                } else {
                    socket.emit('new message', {
                        username: username.value,
                        message: writeMessage.value.slice(0, -1)
                    });
                    writeMessage.value = '';
                }
            }
        })
    </script>
</body>
</html>
